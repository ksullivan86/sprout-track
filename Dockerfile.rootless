# Use the correct upstream image
FROM sprouttrack/sprout-track:latest

USER root

# ==============================================================================
# 1. PATCH THE STARTUP SCRIPT (Safe Syntax Modifications)
# ==============================================================================
# Instead of deleting lines and breaking bash syntax, we safely redirect the 
# root-only file modifications to /tmp, and replace 'crond' with 'true'.
RUN sed -i 's/\/etc\/TZ/\/tmp\/TZ/g' /usr/local/bin/docker-startup.sh && \
    sed -i 's/\/etc\/localtime/\/tmp\/localtime/g' /usr/local/bin/docker-startup.sh && \
    sed -i 's/\bcrond\b/true/g' /usr/local/bin/docker-startup.sh

# ==============================================================================
# 2. THE KUBERNETES ENV WRAPPER
# ==============================================================================
# Prisma strictly requires variables to be in a physical .env file.
# This wrapper dumps the Kubernetes process environment into the exact file
# Sprout Track reads from before handing off to the main startup script.
RUN echo '#!/bin/sh' > /usr/local/bin/k8s-wrapper.sh && \
    echo 'mkdir -p /app/env' >> /usr/local/bin/k8s-wrapper.sh && \
    echo 'env > /app/env/.env' >> /usr/local/bin/k8s-wrapper.sh && \
    echo 'env > /app/.env' >> /usr/local/bin/k8s-wrapper.sh && \
    echo 'exec /usr/local/bin/docker-startup.sh "$@"' >> /usr/local/bin/k8s-wrapper.sh && \
    chmod +x /usr/local/bin/k8s-wrapper.sh

# ==============================================================================
# 3. SET PERMISSIONS & DROP PRIVILEGES
# ==============================================================================
RUN mkdir -p /db && \
    chown -R node:node /app /db /usr/local/bin/docker-startup.sh /usr/local/bin/k8s-wrapper.sh

# Execute securely as the built-in UID 1000
USER node

ENTRYPOINT ["/usr/local/bin/k8s-wrapper.sh"]