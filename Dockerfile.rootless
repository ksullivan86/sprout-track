# Use the official, fully-built Sprout Track image as the base
FROM sprouttrack/sprout-track:latest

# Switch to root temporarily to set up our secure environment
USER root

# ==============================================================================
# 1. PATCH THE STARTUP SCRIPT (Fixing the Syntax Error)
# ==============================================================================
# We replace the root-only timezone and crond commands with the shell command 'true'. 
# This preserves the bash syntax (avoiding empty 'if' blocks) while safely bypassing 
# operations that User 1000 does not have permission to execute.
RUN sed -i 's/.*\/etc\/TZ.*/    true/' /usr/local/bin/docker-startup.sh && \
    sed -i 's/.*\/etc\/localtime.*/    true/' /usr/local/bin/docker-startup.sh && \
    sed -i 's/^ *crond.*/    true/' /usr/local/bin/docker-startup.sh

# ==============================================================================
# 2. SET PERMISSIONS (Using the Built-in UID 1000 User)
# ==============================================================================
RUN mkdir -p /db && \
    chown -R node:node /app /db /usr/local/bin/docker-startup.sh

# ==============================================================================
# 3. DROP PRIVILEGES
# ==============================================================================
# Switch back to the non-root user (UID 1000) for all execution
USER node

# The ENTRYPOINT and CMD are automatically inherited from the base image